Description:
This program creates a Sudoku GUI using Tkinter. Users can input values into a 9x9 grid,
validate their solution, clear the board, and view instructions in a separate help window.
"""

import tkinter as tk
from tkinter import messagebox

# Global variables
grid_entries = []  # stores Entry widgets in a 2D list
status_var = None  # used to display status messages
root = None  # main window

def create_main_window():
    """Create the main application window and initialize all components."""
    global root, status_var
    root = tk.Tk()
    root.title("Sudoku Application")

    # Title label
    tk.Label(root, text="Sudoku Puzzle", font=("Arial", 18, "bold")).grid(row=0, column=0, columnspan=9)

    # Instruction label
    tk.Label(root, text="Enter numbers 1–9. Click Check Solution to validate.").grid(row=1, column=0, columnspan=9)

    # Load Sudoku logo
    try:
        from PIL import Image, ImageTk
        logo_path = r"C:\Users\chris\Downloads\Sodoku.webp"
        img = Image.open(logo_path)
        img = img.resize((150, 150))
        logo = ImageTk.PhotoImage(img)
        tk.Label(root, image=logo).grid(row=2, column=0, columnspan=9)
        root.logo = logo  # prevent garbage collection
    except:
        tk.Label(root, text="[Sudoku Logo Image]").grid(row=2, column=0, columnspan=9)

    create_grid()
    create_buttons()

    # Status label
    status_var = tk.StringVar()
    status_var.set("Ready.")
    tk.Label(root, textvariable=status_var, fg="blue").grid(row=12, column=0, columnspan=9)

    root.mainloop()

def create_grid():
    """Create a 9x9 grid of Entry widgets for Sudoku input."""
    global grid_entries
    for r in range(9):
        row_list = []
        for c in range(9):
            e = tk.Entry(root, width=2, font=("Arial", 14), justify="center", relief="solid", bd=1)
            e.grid(row=r+3, column=c, padx=2, pady=2)
            row_list.append(e)
        grid_entries.append(row_list)

def create_buttons():
    """Create all buttons and assign callback functions."""
    tk.Button(root, text="Check Solution", command=check_sudoku).grid(row=13, column=0, columnspan=3)
    tk.Button(root, text="Clear Board", command=clear_board).grid(row=13, column=3, columnspan=3)
    tk.Button(root, text="Help", command=open_help_window).grid(row=13, column=6)
    tk.Button(root, text="Exit", command=exit_app).grid(row=13, column=7, columnspan=2)

    # Button for Solving
    tk.Button(root, text="Solve Puzzle", command=solve_puzzle).grid(row=14, column=0, columnspan=4)

def open_help_window():
    """Open a secondary window that displays instructions."""
    help_win = tk.Toplevel(root)
    help_win.title("Help")

    tk.Label(help_win, text="How to Use This App", font=("Arial", 14, "bold")).pack(pady=5)

    # Load help icon
    try:
        from PIL import Image, ImageTk
        help_path = r"C:\Users\chris\Downloads\help.avif"
        img = Image.open(help_path)
        img = img.resize((120, 120))
        help_icon = ImageTk.PhotoImage(img)
        tk.Label(help_win, image=help_icon).pack()
        help_win.help_icon = help_icon
    except:
        tk.Label(help_win, text="[Help Icon Image]").pack()

    help_text = (
        "1. Enter numbers 1–9 into the grid.\n"
        "2. Leave blanks if unsure.\n"
        "3. Click Check Solution to validate.\n"
        "4. Click Clear Board to reset.\n"
        "5. Click Exit to close the program."
    )
    tk.Label(help_win, text=help_text, justify="left").pack(pady=10)

def get_grid_values():
    """Retrieve and validate user input from the grid."""
    grid = []
    for r in range(9):
        row = []
        for c in range(9):
            text = grid_entries[r][c].get().strip()

            if text == "":
                row.append(0)
            elif text.isdigit() and 1 <= int(text) <= 9:
                row.append(int(text))
            else:
                messagebox.showerror("Input Error", f"Invalid entry at row {r+1}, column {c+1}. Use numbers 1–9.")
                return None
        grid.append(row)
    return grid

def is_unit_valid(unit):
    """Check if a row, column, or box contains duplicate values."""
    seen = set()
    for num in unit:
        if num != 0:
            if num in seen:
                return False
            seen.add(num)
    return True

def find_empty(grid):
    """Find an empty cell in the Sudoku grid."""
    for r in range(9):
        for c in range(9):
            if grid[r][c] == 0:
                return r, c
    return None

def is_valid_move(grid, num, pos):
    """Check whether placing a number is valid."""
    row, col = pos

    # Check row
    for c in range(9):
        if grid[row][c] == num and c != col:
            return False

    # Check column
    for r in range(9):
        if grid[r][col] == num and r != row:
            return False

    # Check 3x3 box
    box_x = col // 3
    box_y = row // 3

    for r in range(box_y * 3, box_y * 3 + 3):
        for c in range(box_x * 3, box_x * 3 + 3):
            if grid[r][c] == num and (r, c) != pos:
                return False

    return True

def solve_sudoku(grid):
    """Solve Sudoku using backtracking."""
    empty = find_empty(grid)

    if not empty:
        return True

    row, col = empty

    for num in range(1, 10):
        if is_valid_move(grid, num, (row, col)):
            grid[row][col] = num

            if solve_sudoku(grid):
                return True

            grid[row][col] = 0

    return False

def solve_puzzle():
    """Solve the Sudoku puzzle and display the solution."""
    global status_var

    grid = get_grid_values()

    if grid is None:
        status_var.set("Fix input errors before solving.")
        return

    if solve_sudoku(grid):

        for r in range(9):
            for c in range(9):
                grid_entries[r][c].delete(0, tk.END)
                if grid[r][c] != 0:
                    grid_entries[r][c].insert(0, str(grid[r][c]))

        messagebox.showinfo("Solved", "Sudoku puzzle solved successfully!")
        status_var.set("Puzzle solved.")

    else:
        messagebox.showerror("Error", "No valid Sudoku solution exists.")
        status_var.set("Unable to solve puzzle.")

def check_sudoku():
    """Validate the Sudoku board."""
    global status_var
    grid = get_grid_values()

    if grid is None:
        status_var.set("Fix input errors.")
        return

    # Check rows
    for r in range(9):
        if not is_unit_valid(grid[r]):
            messagebox.showinfo("Result", f"Duplicate found in row {r+1}.")
            status_var.set("Invalid solution.")
            return

    # Check columns
    for c in range(9):
        col = [grid[r][c] for r in range(9)]
        if not is_unit_valid(col):
            messagebox.showinfo("Result", f"Duplicate found in column {c+1}.")
            status_var.set("Invalid solution.")
            return

    # Check 3x3 boxes
    for br in range(3):
        for bc in range(3):
            box = []
            for r in range(br*3, br*3+3):
                for c in range(bc*3, bc*3+3):
                    box.append(grid[r][c])

            if not is_unit_valid(box):
                messagebox.showinfo("Result", "Duplicate found in a 3x3 box.")
                status_var.set("Invalid solution.")
                return

    messagebox.showinfo("Result", "Valid Sudoku solution!")
    status_var.set("Valid solution.")

def clear_board():
    """Clear all entries in the grid."""
    global status_var
    for r in range(9):
        for c in range(9):
            grid_entries[r][c].delete(0, tk.END)
    status_var.set("Board cleared.")

def exit_app():
    """Close the application after confirmation."""
    if messagebox.askyesno("Exit", "Exit the application?"):
        root.destroy()

if __name__ == "__main__":
    create_main_window()
